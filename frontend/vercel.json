{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!_next|api|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "routes": [
    {
      "src": "/_next/(.*)",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

